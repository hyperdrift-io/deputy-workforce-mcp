{
  "name": "@hyperdrift-io/deputy-workforce-mcp",
  "version": "0.1.0",
  "description": "Read-only workforce operations MCP for Deputy",
  "mcpName": "io.github.hyperdrift-io/deputy-workforce-mcp",
  "license": "MIT",
  "type": "module",
  "private": false,
  "bin": {
    "deputy-workforce-mcp": "dist/stdio.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "server.json"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hyperdrift-io/deputy-workforce-mcp.git"
  },
  "homepage": "https://hyperdrift.io/services/mcp-maker",
  "bugs": {
    "url": "https://github.com/hyperdrift-io/deputy-workforce-mcp/issues"
  },
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "dev": "tsx watch src/http.ts",
    "mcp": "tsx src/stdio.ts",
    "build": "tsc -p tsconfig.build.json",
    "type-check": "tsc --noEmit",
    "start": "node dist/http.js",
    "proof:fixture": "node scripts/fixture-proof.mjs",
    "proof:published": "node scripts/fixture-proof.mjs --published",
    "test:telemetry": "node scripts/telemetry-contract.mjs",
    "security:scan": "gitleaks detect --source . --redact"
  },
  "dependencies": {
    "@hyperdrift-io/mcp-service-kit": "^0.1.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@posthog/mcp": "^0.10.1",
    "posthog-node": "^5.46.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
